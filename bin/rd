#!/usr/bin/env bash
set -euo pipefail

# rd — the Resonant Dust dev CLI. One entrypoint for the whole project,
# replacing the old per-tool scripts (gate / st / shared / client / redeploy).
# Supporting logic lives in bin/lib/*.sh.
#
#   rd config [list|set <p>|get <KEY>]   active env/profile (was: st config)
#   rd build <component> [args]          build shared|edge|gateway|spacetime|core
#   rd up|down [target]                  start/stop spacetime|edge|gateway|all
#   rd deploy <edge|gateway|module …>    build + run one component now
#   rd redeploy [--run|--force|...]      detect changes, rebuild + redeploy
#   rd index <seed|show>                 seed/inspect index from content/servers/<env>
#   rd logs <target> [-f]   /  rd ps     tail a component's log / show stack status
#
# A leading `--env <p>` runs ONE invocation against profile <p> (dev|claude|
# test|alpha), overriding bin/.rd-profile without changing the persisted default.

RD_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/lib" && pwd)"
source "$RD_LIB/common.sh"

# ── leading global flag: --env / -e <profile> ────────────────────────────────
# Validate then export RD_PROFILE so resolution (and any nested rd call) honours
# it. An unknown name hard-errors — it never silently falls back to dev.
while [[ $# -gt 0 ]]; do
  case "$1" in
    -e|--env) shift; [[ $# -gt 0 ]] || rd_die "--env needs a value"
              case " $RD_KNOWN_PROFILES " in *" $1 "*) ;; *) rd_die "unknown env '$1' (known: $RD_KNOWN_PROFILES)";; esac
              export RD_PROFILE="$1"; shift ;;
    --env=*)  export RD_PROFILE="${1#*=}"; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

rd_resolve_env

# ── rd config ────────────────────────────────────────────────────────────────
rd_config() {
  local sub="${1:-list}"
  case "$sub" in
    list)
      printf '%-18s %s\n' "RD_PROFILE"   "$RD_PROFILE  (from $RD_PROFILE_SOURCE)"
      printf '%-18s %s\n' "RD_ENV"       "$RD_ENV"
      printf '%-18s %s\n' "RD_ST_SERVER" "$RD_ST_SERVER"
      printf '%-18s %s\n' "RD_DB"        "$(rd_db_for zone)"
      printf '%-18s %s\n' "RD_GATEWAY"   "$RD_GATEWAY  (client-facing)"
      printf '%-18s %s\n' "RD_EDGE"      "$RD_EDGE_SERVICE  :$RD_EDGE_PORT  (build/deploy)"
      printf '%-18s %s\n' "RD_CONTEXT"   "${RD_DOCKER_CONTEXT:-<local>}"
      printf '%-18s %s\n' "RD_ST_COMPOSE"     "${RD_ST_COMPOSE/#$REPO\//}"
      printf '%-18s %s\n' "RD_EDGE_COMPOSE" "${RD_EDGE_COMPOSE/#$REPO\//}"
      ;;
    get)
      # Machine-readable single value (for scripts): rd config get RD_GATEWAY.
      case "${2:-}" in
        RD_PROFILE)   echo "$RD_PROFILE" ;;
        RD_ENV)       echo "$RD_ENV" ;;
        RD_ST_SERVER) echo "$RD_ST_SERVER" ;;
        RD_DB)        rd_db_for zone ;;
        RD_GATEWAY)   echo "$RD_GATEWAY" ;;
        RD_GATEWAY_PORT)   echo "$RD_GATEWAY_PORT" ;;
        RD_EDGE_PORT)    echo "$RD_EDGE_PORT" ;;
        RD_EDGE_SERVICE) echo "$RD_EDGE_SERVICE" ;;
        RD_CONTEXT)   echo "$RD_DOCKER_CONTEXT" ;;
        *) rd_die "config get: unknown key '${2:-}'" ;;
      esac
      ;;
    set)
      local p="${2:-}"
      case "$p" in
        dev|claude|test|alpha) ;;
        "") rd_die "usage: rd config set <dev|claude|test|alpha>" ;;
        *)  rd_die "unknown profile '$p' (known: $RD_KNOWN_PROFILES)" ;;
      esac
      printf '%s\n' "$p" > "$PROFILE_FILE"
      rd_log "profile → $p"
      # Re-exec so the printed config reflects the new profile (clear RD_PROFILE
      # so the file we just wrote is what's read).
      RD_PROFILE="" exec "$0" config list
      ;;
    *) rd_die "usage: rd config [list | set <profile> | get <KEY>]" ;;
  esac
}

usage() {
  cat >&2 <<EOF
usage: rd [--env <profile>] <command> [args...]

commands:
  config [list|set <p>|get <KEY>]   active env/profile + derived settings
  build <component> [args]          build shared | edge | gateway | spacetime | core
  up   [spacetime|edge|gateway|all]     start container(s) (default all; ensures network)
  down [spacetime|edge|gateway|all]     stop  container(s) (default all)
  deploy <edge|gateway|module <name>>   build + run one component now
  redeploy [--run|--force|--no-reset|--mark]
                                    detect changed units, rebuild + redeploy
  index <seed|show>                 seed/inspect the index routing directory
                                    from content/servers/<env>
  logs <spacetime|edge|gateway> [-f]    tail a component's log
  ps                                container status across all three stacks
  docs-check [--quiet|--list]       audit docs/ invariants (see docs/README.md)
  work-check [--quiet]              flag a premature pause in the active work stream

typical local test loop:
  rd up                 # network + spacetime daemon + idle edge/gateway containers
  rd redeploy --run     # publish modules, build + run edge + gateway
  rd ps                 # confirm everything's up

profiles (envs): dev claude test alpha   (alpha = remote lightsail)
EOF
}

cmd="${1:-}"
[[ -n "$cmd" ]] && shift || true
case "$cmd" in
  config)   rd_config "$@" ;;
  build)    source "$RD_LIB/build.sh";    rd_build "$@" ;;
  up)       source "$RD_LIB/stack.sh";    rd_up "$@" ;;
  down)     source "$RD_LIB/stack.sh";    rd_down "$@" ;;
  ps)       source "$RD_LIB/stack.sh";    rd_ps "$@" ;;
  logs)     source "$RD_LIB/stack.sh";    rd_logs "$@" ;;
  deploy)   source "$RD_LIB/build.sh"; source "$RD_LIB/redeploy.sh"; source "$RD_LIB/stack.sh"; rd_deploy "$@" ;;
  redeploy) source "$RD_LIB/build.sh"; source "$RD_LIB/redeploy.sh"; source "$RD_LIB/index.sh"; rd_redeploy "$@" ;;
  index)    source "$RD_LIB/index.sh";   rd_index "$@" ;;
  docs-check) source "$RD_LIB/docs.sh";  rd_docs_check "$@" ;;
  work-check) source "$RD_LIB/docs.sh";  rd_work_check "$@" ;;
  -h|--help|help|"") usage ;;
  *) rd_warn "unknown command '$cmd'"; usage; exit 1 ;;
esac
