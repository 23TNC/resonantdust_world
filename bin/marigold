#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# venv front-end for the Marigold-IID de-lighter, mirroring bin/laigter's role as
# the raw tool wrapper. `bin/art delight <object>` is the batch front-end; this
# drives marigold/delight.py directly and manages its venv. GPU: the WSL2 NVIDIA
# driver exposes the 2080 Ti to torch (fp16), no Docker needed.
MARIGOLD_DIR="$REPO_ROOT/marigold"
VENV="${MARIGOLD_VENV:-$MARIGOLD_DIR/.venv}"
PY="$VENV/bin/python"

usage() {
  cat >&2 <<EOF
usage: marigold <command|delight ...>

commands:
  build [--torch-index URL]   create the venv + install requirements.txt
                              (--torch-index forces a specific torch wheel index,
                               e.g. https://download.pytorch.org/whl/cu124)
  config                      print venv + script paths, torch/CUDA status
  delight <paths...> [flags]  de-light diffuse sprites -> N.albedo.png
                              (flags: --emit --out-dir --steps --ensemble
                                      --resolution --seed --model --no-half
                                      --skip-existing; see delight.py -h)
  normals <paths...> [flags]  surface-normals for diffuse sprites -> N.normal.png
                              (flags: --out-dir --steps --ensemble --resolution
                                      --seed --model --no-half --skip-existing;
                                      see normals.py -h)
  depth <paths...> [flags]    16-bit height field for diffuse sprites -> N.depth.png
                              (flags: as normals, plus --visualize; see depth.py -h)
                              MONOCULAR (reads the diffuse; flattens on flat art).
  normal-depth <paths...>     16-bit height field by INTEGRATING each co-located
                              N.normal.png -> N.depth.png. No model/GPU (FFT
                              Frankot-Chellappa). Works on flat art; needs the
                              normal to exist first. (flags: --invert --visualize
                              --nz-floor --grad-clip --out-dir --skip-existing;
                              see normal_depth.py -h)

override the venv location via env: MARIGOLD_VENV
EOF
}

case "${1:-}" in
  build|setup)
    shift
    torch_index=""
    while (( $# )); do
      case "$1" in
        --torch-index) torch_index=${2:?--torch-index needs a URL}; shift 2 ;;
        --torch-index=*) torch_index=${1#*=}; shift ;;
        *) echo "marigold build: unknown flag '$1'" >&2; exit 1 ;;
      esac
    done
    # torch must match the CUDA driver: the default PyPI wheel targets the newest
    # CUDA (cu13x) and fails on an older driver ("driver too old", cuda=False).
    # The 2080 Ti box runs a CUDA 12.9 driver, so pin a cu12 build. Install torch
    # from the CUDA index FIRST, then the rest from PyPI (torch>=2.1 is satisfied,
    # so it won't get upgraded to a mismatched wheel).
    cu_index=${torch_index:-https://download.pytorch.org/whl/cu124}
    # Prefer uv (fast, and doesn't need the system python3-venv/ensurepip that
    # Debian/WSL often lacks); fall back to stdlib venv + pip.
    if command -v uv >/dev/null 2>&1; then
      uv venv "$VENV"
      uv pip install --python "$PY" --index-url "$cu_index" torch
      uv pip install --python "$PY" -r "$MARIGOLD_DIR/requirements.txt"
    else
      python3 -m venv "$VENV"
      "$VENV/bin/pip" install --upgrade pip
      "$VENV/bin/pip" install --index-url "$cu_index" torch
      "$VENV/bin/pip" install -r "$MARIGOLD_DIR/requirements.txt"
    fi
    "$PY" - <<'EOF'
import torch
print(f"marigold: torch {torch.__version__}, cuda available: {torch.cuda.is_available()}")
if torch.cuda.is_available():
    print(f"marigold: device 0 = {torch.cuda.get_device_name(0)}")
EOF
    ;;
  config)
    echo "venv:   $VENV"
    echo "script: $MARIGOLD_DIR/delight.py"
    if [[ -x "$PY" ]]; then
      "$PY" - <<'EOF' 2>/dev/null || true
import torch
print(f"torch:  {torch.__version__} (cuda {'yes' if torch.cuda.is_available() else 'no'})")
EOF
    else
      echo "torch:  (venv not built — run 'bin/marigold build')"
    fi
    ;;
  delight)
    shift
    [[ -x "$PY" ]] || { echo "marigold: venv missing — run 'bin/marigold build'" >&2; exit 1; }
    exec "$PY" "$MARIGOLD_DIR/delight.py" "$@"
    ;;
  normals)
    shift
    [[ -x "$PY" ]] || { echo "marigold: venv missing — run 'bin/marigold build'" >&2; exit 1; }
    exec "$PY" "$MARIGOLD_DIR/normals.py" "$@"
    ;;
  atlas-normals)
    # marigold-linked-normals P1: per-cell inference for LINKED (grid) atlases —
    # replicated-edge context, pinned seed; --align/--symmetrize post passes.
    shift
    [[ -x "$PY" ]] || { echo "marigold: venv missing — run 'bin/marigold build'" >&2; exit 1; }
    exec "$PY" "$MARIGOLD_DIR/atlas_normals.py" "$@"
    ;;
  atlas-check)
    # The consistency oracle (flat frame / same piece / seams). Plain python3 — no venv.
    shift
    exec python3 "$MARIGOLD_DIR/atlas_check.py" "$@"
    ;;
  depth)
    shift
    [[ -x "$PY" ]] || { echo "marigold: venv missing — run 'bin/marigold build'" >&2; exit 1; }
    exec "$PY" "$MARIGOLD_DIR/depth.py" "$@"
    ;;
  normal-depth)
    shift
    [[ -x "$PY" ]] || { echo "marigold: venv missing — run 'bin/marigold build'" >&2; exit 1; }
    exec "$PY" "$MARIGOLD_DIR/normal_depth.py" "$@"
    ;;
  -h|--help|help|"") usage ;;
  *) echo "marigold: unknown command '$1'" >&2; usage; exit 1 ;;
esac
