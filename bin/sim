#!/usr/bin/env bash
# sim — build & run the rebuild's SDK-client "sim" crates (master, orchestrator, worker).
#
# These are long-lived native binaries (like the edge), not wasm modules and not host-cargo builds.
# They share ../st-bindings and ../../shared/codec by path, so the whole repo is mounted and the
# workdir points at the crate. A small builder image (rust:slim + openssl/git) is cached so we don't
# apt-get on every build; the same image runs the binary (it already carries libssl3).
#
#   sim build  <crate>            cargo build --release, in docker
#   sim check  <crate>            cargo check --all-targets (fast, no link)
#   sim run    <crate> [K=V ...]  (re)start the built binary detached, extra env passed through
#   sim stop   <crate>            stop + remove its container
#   sim logs   <crate> [-f]       tail its container logs
#   sim ps                        list running sim containers
#
# Crates live under server/<crate>. ENV for `run` is whatever the binary reads (ST_URI, TIC_HZ,
# ORCHESTRATOR, WORKERS, EVENT_DB, DATA_DB, RUST_LOG, …).
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="rd-sim-builder"
CARGO_VOL="rd-sim-cargo"       # shared registry cache so crates reuse each other's downloads
SIM_CRATES=(master orchestrator worker)

die() { echo "sim: $*" >&2; exit 1; }
log() { echo "── $*"; }

# A sim crate's repo-relative dir — the server trio under server/, the npc driver under
# client/ (first-pawns F6: one supervisor for every headless sim process).
crate_dir() {
  case "$1" in
    npc) echo "client/npc" ;;
    *)   echo "server/$1" ;;
  esac
}

require_crate() {
  local c="$1"
  [[ -f "$REPO/$(crate_dir "$c")/Cargo.toml" ]] || die "no crate at $(crate_dir "$c") (have: ${SIM_CRATES[*]} npc)"
}

# Build the cached builder image if missing (or FORCE_IMAGE=1). rust:slim + the TLS/build deps the
# SDK needs; libssl3 comes in via libssl-dev, so this image also *runs* the binaries.
ensure_image() {
  if [[ "${FORCE_IMAGE:-0}" != 1 ]] && docker image inspect "$IMAGE" >/dev/null 2>&1; then
    return
  fi
  log "building $IMAGE (rust:slim + openssl/pkg-config/git)"
  docker build -t "$IMAGE" - >/dev/null <<'DOCKERFILE'
FROM rust:slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends libssl-dev pkg-config git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
DOCKERFILE
}

# Run a one-shot cargo command in the builder, repo mounted, workdir at the crate.
cargo_in() {
  local crate="$1"; shift
  ensure_image
  docker run --rm --network host \
    -v "$REPO":/workspace \
    -v "$CARGO_VOL":/usr/local/cargo/registry \
    -w "/workspace/$(crate_dir "$crate")" \
    "$IMAGE" "$@"
}

# Build, and guard the docker/WSL2 MTIME MISS: cargo sometimes reports `Finished` with no
# `Compiling <crate>` after a real source change → the old binary silently survives (cost two
# debugging loops on 2026-07-28). Detect stale-source-before + no-compile-line and warn loudly.
cmd_build() {
  require_crate "$1"
  log "build $1 → release binary"
  local bin="$REPO/$(crate_dir "$1")/target/release/$1"
  local stale=""
  [[ -x "$bin" ]] && stale="$(newer_sources "$1" "$bin")"
  local out
  out="$(cargo_in "$1" cargo build --release 2>&1)" || { echo "$out"; die "build failed for $1"; }
  echo "$out" | tail -2
  if [[ -n "$stale" ]] && ! grep -q "Compiling $1 " <<<"$out"; then
    echo "── WARNING: sources changed ($stale) but cargo recompiled nothing — the docker mtime"
    echo "   miss. Run: touch $(crate_dir "$1")/src/*.rs && bin/sim build $1"
  fi
}
cmd_check() { require_crate "$1"; log "check $1"; cargo_in "$1" cargo check --all-targets; }

# The path-dep source roots a crate's binary is built from — the stale-binary guard sweeps
# these for files newer than the binary.
dep_roots() {
  case "$1" in
    npc) echo "client/npc/src client/core/src shared/codec/src shared/dsl/src" ;;
    *)   echo "$(crate_dir "$1")/src server/st-bindings/src server/uplink/src shared/codec/src" ;;
  esac
}

newer_sources() { # <crate> <binary> → first newer source path, if any
  local crate="$1" bin="$2" root
  for root in $(dep_roots "$crate"); do
    [[ -d "$REPO/$root" ]] || continue
    local hit
    hit="$(find "$REPO/$root" -name '*.rs' -newer "$bin" -print -quit 2>/dev/null)"
    [[ -n "$hit" ]] && { echo "${hit#"$REPO"/}"; return 0; }
  done
  return 0
}

cmd_run() {
  local crate="$1"; shift || true
  require_crate "$crate"
  ensure_image
  local bin="$(crate_dir "$crate")/target/release/$crate"
  [[ -x "$REPO/$bin" ]] || die "not built — run 'sim build $crate' first ($bin missing)"
  # Refuse a binary older than its sources: a failed build must not silently run yesterday's
  # code (it did, twice, on 2026-07-28). FORCE=1 overrides.
  local stale
  stale="$(newer_sources "$crate" "$REPO/$bin")"
  if [[ -n "$stale" && "${FORCE:-0}" != 1 ]]; then
    die "$bin is OLDER than $stale — run 'sim build $crate' first (or FORCE=1 to run it anyway)"
  fi
  # Pass K=V args through as -e; default RUST_LOG if unset.
  local envs=(-e "RUST_LOG=${RUST_LOG:-$crate=info}")
  local kv
  for kv in "$@"; do
    [[ "$kv" == *=* ]] || die "run env must be K=V, got '$kv'"
    envs+=(-e "$kv")
  done
  docker rm -f "rd-$crate" >/dev/null 2>&1 || true
  log "run $crate (detached, container rd-$crate)"
  # --restart=on-failure: a crashed/failed-at-startup binary retries (paced by docker) — e.g.
  # the npc exiting 1 while the edge is still coming up. A clean exit stays down.
  docker run -d --name "rd-$crate" --network host --restart=on-failure:10 \
    -v "$REPO":/workspace -w /workspace \
    "${envs[@]}" \
    "$IMAGE" "/workspace/$bin" >/dev/null
  echo "   logs: bin/sim logs $crate -f"
}

cmd_stop() { log "stop rd-$1"; docker rm -f "rd-$1" >/dev/null 2>&1 || true; }
cmd_logs() { local c="$1"; shift || true; docker logs "$@" "rd-$c"; }
cmd_ps()   { docker ps --filter "name=rd-" --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'; }

usage() {
  sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
  local cmd="${1:-}"; [[ -n "$cmd" ]] && shift || { usage; exit 1; }
  case "$cmd" in
    build) cmd_build "$@" ;;
    check) cmd_check "$@" ;;
    run)   cmd_run "$@" ;;
    stop)  cmd_stop "$@" ;;
    logs)  cmd_logs "$@" ;;
    ps)    cmd_ps ;;
    -h|--help|help) usage ;;
    *) die "unknown command '$cmd' (build|check|run|stop|logs|ps)" ;;
  esac
}
main "$@"
