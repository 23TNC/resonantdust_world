#!/usr/bin/env bash
# git **pre-commit** hook — the hard gate: refuse a commit that would leave docs/
# out of compliance, or land a non-TOML file under content/. Complements the
# Claude Code Stop hook (per-turn feedback); this guarantees the committed
# history is never broken, from any source.
#
# Installed as a symlink at .git/hooks/pre-commit (see docs/work/docs-authority/).
# Escape hatch for a deliberate exception:  SKIP_DOCS_CHECK=1 git commit ...
# (one var for both checks — a deliberate bypass is deliberate about all of it).
set -uo pipefail

[[ "${SKIP_DOCS_CHECK:-}" == "1" ]] && { echo "pre-commit: checks skipped (SKIP_DOCS_CHECK=1)" >&2; exit 0; }

REPO="$(git rev-parse --show-toplevel)"
if ! "$REPO/bin/rd" docs-check; then
  {
    echo
    echo "pre-commit: docs-check failed — fix the above, or bypass with:"
    echo "    SKIP_DOCS_CHECK=1 git commit ..."
  } >&2
  exit 1
fi
# content-toml-only P4: content/ is the authored TOML corpus and nothing else.
# Reads the INDEX, so a staged stray is caught here rather than discovered later.
if ! "$REPO/bin/rd" content-check --quiet; then
  {
    echo
    echo "pre-commit: content-check failed — move the file, or bypass with:"
    echo "    SKIP_DOCS_CHECK=1 git commit ..."
  } >&2
  exit 1
fi
exit 0
