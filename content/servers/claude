# content/servers/claude — index routing topology for the `claude` environment.
# See content/servers/dev for the full format reference. The claude env is the
# agent's local stack: gateway :9474, server :8474 (8xxx = server, 9xxx = gateway).

# One world server, the local claude game server on :8474.
server 0 ws://localhost:8474/ws

# One data shard — the claude region_shard DB on the shared local daemon.
shard 0 http://start:3000 resonantdust-claude-region_shard-0

