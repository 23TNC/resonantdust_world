# Claude local state
.claude/scheduled_tasks.lock

# Godot editor/cache data
.import/
.godot/
*.import

/bin/keys/*

# UID files
*.uid

# Android export build
/android/

# Build/export output directories
/build/
dist/
# bin/ holds tracked CLI tooling (rd, art, dsl, marigold, lib/); ignore only its
# local state, not the scripts. (keys/ is covered by /bin/keys/* above.)
/bin/.build-state/
/bin/.rd-profile
/spacetime/server/spacetimedb/target/
/spacetime/config
/spacetime/data
/spacetime/.build-state/
/spacetime/keys/
# Per-module Rust build output (the root-anchored /target/ above misses these)
/spacetime/server/modules/*/target/
# Component build output (root-anchored /target/ above misses nested crates)
/gateway/target/
/server/target/
/client/target/
/npc/target/
/server_master/target/
/server_simulation/target/

# spacetimedb data
/spacetime-data/*
/spacetime-keys/*

/pixijs/src/data
# Exported games
*.pck
*.apk
*.aab
*.exe
*.x86_64
*.arm64
*.ipa

# OS junk
.DS_Store
Thumbs.db

# Rust build artifacts
/target/
**/*.rs.bk

# Cargo
Cargo.lock

# SpaceTimeDB local state
.spacetimedb/
spacetimedb.db

# Environment / secrets
.env
.env.*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# npm
pixijs/node_modules/*

# Textures directory (derived/regenerated by bin/art, served from R2)
/textures/

# Marigold de-lighting: venv + HF model cache are multi-GB, regenerated by
# `bin/marigold build` (the code under marigold/ IS tracked)
/marigold/.venv/
/marigold/.cache/
__pycache__/
*.pyc
